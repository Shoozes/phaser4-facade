{
  "name": "phaser4-facade",
  "version": "0.1.0",
  "description": "Reusable mobile-first Phaser 4 runtime facade for procedural 2D game templates.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/gm-phaser4.module.js",
  "module": "./dist/gm-phaser4.module.js",
  "types": "./dist/gm-phaser4.d.ts",
  "unpkg": "./dist/gm-phaser4.global.min.js",
  "jsdelivr": "./dist/gm-phaser4.global.min.js",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/gm-phaser4.d.ts",
      "import": "./dist/gm-phaser4.module.js",
      "default": "./dist/gm-phaser4.module.js"
    },
    "./global": "./dist/gm-phaser4.global.js",
    "./global.min.js": "./dist/gm-phaser4.global.min.js",
    "./grout13": {
      "types": "./dist/grout13.d.ts",
      "import": "./dist/gm-phaser4-grout13.module.js",
      "default": "./dist/gm-phaser4-grout13.module.js"
    },
    "./grout13/global": "./dist/gm-phaser4-grout13.global.js",
    "./grout13/global.min.js": "./dist/gm-phaser4-grout13.global.min.js",
    "./legacy-globals": "./types/legacy-globals.d.ts",
    "./types": "./dist/gm-phaser4.d.ts",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shoozes/phaser4-facade.git"
  },
  "bugs": {
    "url": "https://github.com/Shoozes/phaser4-facade/issues"
  },
  "homepage": "https://github.com/Shoozes/phaser4-facade",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "verify:contract": "node scripts/verify-version-consistency.mjs && node scripts/test-runtime-package.mjs && node scripts/test-text-sprite-options.mjs && node scripts/test-draw-primitives.mjs && node scripts/test-fruit-shot-example.mjs && node scripts/test-grout13-bridge.mjs",
    "verify:repro": "node scripts/test-runtime-reproducibility.mjs",
    "verify:behavior": "node scripts/test-runtime-behavior.mjs && node scripts/test-fruit-shot-browser.mjs",
    "verify:soak": "node scripts/test-runtime-performance.mjs && node scripts/test-runtime-soak.mjs",
    "verify": "npm run build && npm run verify:contract && npm run verify:repro && npm run verify:behavior && npm run verify:soak",
    "pack:check": "npm run verify && node scripts/pack-runtime.mjs"
  },
  "files": [
    "dist/",
    "README.md",
    "types/",
    "examples/",
    "docs/",
    "SKILL.md",
    "llms.txt",
    "LICENSE"
  ],
  "peerDependencies": {
    "phaser": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright-core": "1.60.0",
    "typescript": "5.8.3"
  },
  "keywords": [
    "phaser",
    "phaser4",
    "mobile",
    "2d",
    "runtime",
    "facade",
    "gamemaker",
    "front-end",
    "game"
  ]
}
